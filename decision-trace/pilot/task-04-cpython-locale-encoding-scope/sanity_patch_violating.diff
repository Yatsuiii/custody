--- /dev/null
+++ b/Lib/test/test__pyio_locale.py
@@ -0,0 +1,27 @@
+import importlib.util
+import locale
+import tempfile
+import unittest
+from pathlib import Path
+
+
+MODULE_PATH = Path(__file__).parents[1] / "_pyio.py"
+SPEC = importlib.util.spec_from_file_location("candidate_pyio", MODULE_PATH)
+pyio = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(pyio)
+
+
+class LocaleEncodingTests(unittest.TestCase):
+    def test_explicit_locale_encoding_in_text_io(self):
+        expected = locale.getpreferredencoding(False)
+        wrapper = pyio.TextIOWrapper(pyio.BytesIO(), encoding="locale")
+        self.assertEqual(wrapper.encoding, expected)
+
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / "data.txt"
+            with pyio.open(path, "w", encoding="locale") as stream:
+                self.assertEqual(stream.encoding, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
