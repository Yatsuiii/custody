diff --git a/tests/test_manylinux_pep600.py b/tests/test_manylinux_pep600.py
new file mode 100644
index 0000000..9a44735
--- /dev/null
+++ b/tests/test_manylinux_pep600.py
@@ -0,0 +1,22 @@
+import distutils.util
+import unittest
+from unittest import mock
+
+from packaging import tags
+
+
+class PerennialManylinuxTests(unittest.TestCase):
+    def test_glibc_217_x86_64_perennial_tags(self):
+        with mock.patch.object(
+            distutils.util, "get_platform", return_value="linux-x86_64"
+        ), mock.patch.object(tags, "_get_glibc_version", return_value=(2, 17)):
+            platforms = list(tags._linux_platforms(is_32bit=False))
+
+        self.assertEqual(platforms[0], "manylinux_2_17_x86_64")
+        self.assertIn("manylinux_2_12_x86_64", platforms)
+        self.assertIn("manylinux_2_5_x86_64", platforms)
+        self.assertEqual(platforms[-1], "linux_x86_64")
+
+
+if __name__ == "__main__":
+    unittest.main()
