diff --git a/src/pip/_internal/req/script_metadata.py b/src/pip/_internal/req/script_metadata.py
new file mode 100644
--- /dev/null
+++ b/src/pip/_internal/req/script_metadata.py
@@ -0,0 +1,27 @@
+import re
+
+
+_HEADER = re.compile(r"(?i)^#\s+script\s+dependencies:\s*$")
+
+
+def read_script_dependencies(scriptfile: str) -> list[str]:
+    """Read dependencies from an inline script dependency comment block."""
+    with open(scriptfile, encoding="utf-8") as script_stream:
+        lines = iter(script_stream)
+        for line in lines:
+            if _HEADER.match(line):
+                break
+        else:
+            raise ValueError("script has no dependency metadata block")
+
+        dependencies = []
+        for line in lines:
+            if not line.startswith("#"):
+                break
+            dependency = line[1:].split(" # ", maxsplit=1)[0].strip()
+            if dependency:
+                dependencies.append(dependency)
+
+    if not dependencies:
+        raise ValueError("script dependency block is empty")
+    return dependencies
diff --git a/tests/unit/test_script_metadata.py b/tests/unit/test_script_metadata.py
new file mode 100644
--- /dev/null
+++ b/tests/unit/test_script_metadata.py
@@ -0,0 +1,29 @@
+import tempfile
+import unittest
+from pathlib import Path
+
+from pip._internal.req.script_metadata import read_script_dependencies
+
+
+class ScriptMetadataTests(unittest.TestCase):
+    def test_reads_dependencies_in_source_order(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            script = Path(directory, "example.py")
+            script.write_text(
+                """\
+# Script Dependencies:
+# requests<3
+# rich
+
+print(\"hello\")
+""",
+                encoding="utf-8",
+            )
+            self.assertEqual(
+                read_script_dependencies(str(script)),
+                ["requests<3", "rich"],
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
