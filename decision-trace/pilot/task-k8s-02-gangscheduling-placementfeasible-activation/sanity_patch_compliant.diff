+// activateUnscheduledPods re-activates a pod group's remaining unscheduled pods so they get
+// retried promptly while the group is waiting on its MinCount quorum during the pod group
+// scheduling cycle. This is the PlacementFeasible-native equivalent of the activation that
+// permitPodGroup/permitPodForHierarchy perform on the Permit path for the ordinary,
+// pod-by-pod scheduling cycle; RunPermitPlugins is never invoked from the pod group
+// scheduling cycle (see pkg/scheduler/schedule_one_podgroup.go), so Permit's activation
+// never runs for gang-scheduled groups here.
+func (pl *GangScheduling) activateUnscheduledPods(logger klog.Logger, podGroupInfo fwk.PodGroupInfo) {
+	unscheduled := podGroupInfo.GetUnscheduledPods()
+	if len(unscheduled) == 0 {
+		return
+	}
+	pods := make(map[string]*v1.Pod, len(unscheduled))
+	for _, pod := range unscheduled {
+		pods[pod.Name] = pod
+	}
+	pl.handle.Activate(logger, pods)
+}
