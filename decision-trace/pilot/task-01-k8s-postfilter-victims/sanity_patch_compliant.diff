@@ -68,10 +68,29 @@ type Evaluator struct {
 
 	enableAsyncPreemption bool
 
+	// victimsMu guards lastVictims.
+	victimsMu sync.Mutex
+	// lastVictims records the victim Pods chosen by the most recently
+	// successful Preempt call. It is scoped to this package only (it does
+	// not extend fwk.PostFilterResult, which kubernetes/kubernetes#136254
+	// attempted and kubernetes/kubernetes#137662 reverted because
+	// delayed preemption was dropped from the 1.36 scope). It exists so
+	// in-tree tests can assert on which Pods preemption selected without
+	// widening the out-of-tree scheduler framework API.
+	lastVictims []*v1.Pod
+
 	*Executor
 	Interface
 }
 
+// LastVictims returns the victim Pods selected by the most recent successful
+// Preempt call, or nil if none has completed yet. For test introspection only.
+func (ev *Evaluator) LastVictims() []*v1.Pod {
+	ev.victimsMu.Lock()
+	defer ev.victimsMu.Unlock()
+	return ev.lastVictims
+}
