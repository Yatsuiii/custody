index 0000000..4221f48
--- /dev/null
+++ b/axum-core/src/extract/option.rs
@@ -0,0 +1,34 @@
+use std::future::Future;
+
+use http::request::Parts;
+
+use crate::response::IntoResponse;
+
+use super::FromRequestParts;
+
+/// Defines the extractor-specific meaning of absence for `Option<Self>`.
+pub trait OptionalFromRequestParts<S>: Sized {
+    /// Rejection returned when extraction fails for a reason other than absence.
+    type Rejection: IntoResponse;
+
+    /// Extract an optional value while preserving non-absence failures.
+    fn from_request_parts(
+        parts: &mut Parts,
+        state: &S,
+    ) -> impl Future<Output = Result<Option<Self>, Self::Rejection>> + Send;
+}
+
+impl<S, T> FromRequestParts<S> for Option<T>
+where
+    T: OptionalFromRequestParts<S>,
+    S: Send + Sync,
+{
+    type Rejection = T::Rejection;
+
+    fn from_request_parts(
+        parts: &mut Parts,
+        state: &S,
+    ) -> impl Future<Output = Result<Option<T>, Self::Rejection>> {
+        T::from_request_parts(parts, state)
+    }
+}
