+// PostFilterVictimsStateKey is the CycleState key under which Preempt records the victim Pods
+// it selected for the nominated node. Callers that need to know exactly which Pods preemption
+// chose to evict during a PostFilter call (as opposed to just the nominated node name carried by
+// PostFilterResult) can read it back from the same CycleState passed into that call.
+const PostFilterVictimsStateKey fwk.StateKey = "PostFilterVictims"
+
+// PostFilterVictimsState wraps the victims recorded under PostFilterVictimsStateKey.
+type PostFilterVictimsState struct {
+	Victims *extenderv1.Victims
+}
+
+// Clone implements fwk.StateData. The stored victims are treated as immutable once written, so
+// clones simply share the same value.
+func (s *PostFilterVictimsState) Clone() fwk.StateData {
+	return s
+}
+
