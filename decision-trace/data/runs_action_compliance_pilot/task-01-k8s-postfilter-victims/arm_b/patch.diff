diff --git a/pkg/scheduler/framework/preemption/preemption.go b/pkg/scheduler/framework/preemption/preemption.go
index 4264076..bbf95cb 100644
--- a/pkg/scheduler/framework/preemption/preemption.go
+++ b/pkg/scheduler/framework/preemption/preemption.go
@@ -72,6 +72,45 @@ type Evaluator struct {
 	Interface
 }
 
+// victimsStateKey is the CycleState key under which the victim Pods chosen by
+// the most recent successful Preempt call in this scheduling cycle are stored.
+//
+// PostFilterResult intentionally carries only the nominated node name (see
+// https://github.com/kubernetes/kubernetes/pull/137662, which reverted an
+// attempt to add a Victims field to PostFilterResult). CycleState is the
+// established in-tree mechanism for a plugin to hand data it computed to a
+// later reader within the same scheduling cycle without widening any public
+// framework interface, so it's used here to make the victims Preempt already
+// computed inspectable (e.g. by tests) without touching PostFilterResult.
+const victimsStateKey fwk.StateKey = "kubernetes.io/preemption-victims"
+
+// victimsStateData wraps the victim Pods so they satisfy fwk.StateData.
+type victimsStateData struct {
+	victims []*v1.Pod
+}
+
+// Clone returns the receiver itself since victimsStateData is treated as
+// immutable after being written to the CycleState.
+func (d *victimsStateData) Clone() fwk.StateData {
+	return d
+}
+
+// VictimsFromCycleState returns the victim Pods chosen by the most recent
+// successful Preempt call recorded in state, or nil if Preempt hasn't
+// written any (e.g. no preemption occurred, or Preempt returned an error or
+// Unschedulable status without a candidate).
+func VictimsFromCycleState(state fwk.CycleState) []*v1.Pod {
+	c, err := state.Read(victimsStateKey)
+	if err != nil {
+		return nil
+	}
+	d, ok := c.(*victimsStateData)
+	if !ok {
+		return nil
+	}
+	return d.victims
+}
+
 func NewEvaluator(pluginName string, fh fwk.Handle, i Interface, enableAsyncPreemption bool) *Evaluator {
 	return &Evaluator{
 		PluginName:            pluginName,
@@ -170,6 +209,8 @@ func (ev *Evaluator) Preempt(ctx context.Context, state fwk.CycleState, pod *v1.
 		}
 	}
 
+	state.Write(victimsStateKey, &victimsStateData{victims: bestCandidate.Victims().Pods})
+
 	return framework.NewPostFilterResultWithNominatedNode(bestCandidate.Name()), fwk.NewStatus(fwk.Success)
 }
 
