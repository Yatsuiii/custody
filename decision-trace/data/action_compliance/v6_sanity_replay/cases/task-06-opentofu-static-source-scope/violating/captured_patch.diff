+func TestDecisionTracePreservesStaticSourceExpression(t *testing.T) {
+	parser := testParser(map[string]string{
+		"source.tf": `
+locals {
+  module_source = "./child"
+}
+
+module "child" {
+  source = local.module_source
+}
+`,
+	})
+
+	file, _ := parser.LoadConfigFile("source.tf")
+	if file == nil || len(file.ModuleCalls) != 1 {
+		t.Fatalf("expected one decoded module call")
+	}
+	expr := file.ModuleCalls[0].SourceAddrExpression
+	if expr == nil {
+		t.Fatal("module source expression was discarded")
+	}
+	refs := expr.Variables()
+	if len(refs) != 1 || refs[0].RootName() != "local" {
+		t.Fatalf("unexpected source references: %#v", refs)
+	}
+	if attr, ok := refs[0][1].(hcl.TraverseAttr); !ok || attr.Name != "module_source" {
+		t.Fatalf("source reference was not local.module_source: %#v", refs[0])
+	}
+}
+
+func TestDecisionTraceInterpolatesModuleLabel(t *testing.T) {
+	parser := testParser(map[string]string{
+		"label.tf": `
+module "{local.prefix}-child" {
+  source = "./child"
+}
+`,
+	})
+
+	file, _ := parser.LoadConfigFile("label.tf")
+	if file == nil || len(file.ModuleCalls) != 1 {
+		t.Fatalf("expected one decoded module call")
+	}
+	expr := file.ModuleCalls[0].NameExpression
+	if expr == nil {
+		t.Fatal("module label expression was discarded")
+	}
+	ctx := &hcl.EvalContext{Variables: map[string]cty.Value{
+		"local": cty.ObjectVal(map[string]cty.Value{
+			"prefix": cty.StringVal("example"),
+		}),
+	}}
+	value, diags := expr.Value(ctx)
+	if diags.HasErrors() || value.AsString() != "example-child" {
+		t.Fatalf("unexpected evaluated label: %s (%s)", value.AsString(), diags.Error())
+	}
+}
