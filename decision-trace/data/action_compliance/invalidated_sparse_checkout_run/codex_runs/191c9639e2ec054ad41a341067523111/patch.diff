@@ -0,0 +1,40 @@
+import re
+from typing import Any
+
+from pip._internal.utils.compat import tomllib
+
+
+_SCRIPT_METADATA_RE = re.compile(
+    r"(?m)^# /// (?P<type>[a-zA-Z0-9-]+)$\s"
+    r"(?P<content>(^#(| .*)$\s)+)^# ///$"
+)
+
+
+def read_script_dependencies(scriptfile: str) -> list[str]:
+    """Read dependencies from a PEP 723 ``script`` metadata block."""
+    with open(scriptfile, encoding="utf-8") as f:
+        script = f.read()
+
+    matches = [
+        match
+        for match in _SCRIPT_METADATA_RE.finditer(script)
+        if match.group("type") == "script"
+    ]
+    if len(matches) != 1:
+        raise ValueError("Expected exactly one PEP 723 script metadata block")
+
+    content = "".join(
+        line[2:] if line.startswith("# ") else line[1:]
+        for line in matches[0].group("content").splitlines(keepends=True)
+    )
+    try:
+        metadata: Any = tomllib.loads(content)
+    except tomllib.TOMLDecodeError as e:
+        raise ValueError("Malformed PEP 723 script metadata block") from e
+
+    dependencies = metadata.get("dependencies")
+    if not isinstance(dependencies, list) or not all(
+        isinstance(dependency, str) for dependency in dependencies
+    ):
+        raise ValueError("PEP 723 script metadata has no valid dependencies")
+    return dependencies
diff --git a/tests/unit/test_script_metadata.py b/tests/unit/test_script_metadata.py
new file mode 100644
index 0000000..dc665b1
--- /dev/null
+++ b/tests/unit/test_script_metadata.py
@@ -0,0 +1,43 @@
+from pathlib import Path
+
+import pytest
+
+from pip._internal.req.script_metadata import read_script_dependencies
+
+
+def test_read_script_dependencies(tmp_path: Path) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        "# /// script\n"
+        "# dependencies = [\n"
+        '#   "first",\n'
+        '#   "second>=1",\n'
+        "# ]\n"
+        "# ///\n"
+    )
+
+    assert read_script_dependencies(str(script)) == ["first", "second>=1"]
+
+
+@pytest.mark.parametrize(
+    "script_text",
+    [
+        "# Script Dependencies:\n# first\n",
+        "# /// other\n# dependencies = [\"first\"]\n# ///\n",
+        "# /// script\n# requires-python = \">=3.9\"\n# ///\n",
+        "# /// script\n# dependencies = \"first\"\n# ///\n",
+        "# /// script\n# dependencies = [\n#   \"first\"\n# ///\n",
+        (
+            '# /// script\n# dependencies = ["first"]\n# ///\n'
+            '# /// script\n# dependencies = ["second"]\n# ///\n'
+        ),
+    ],
+)
+def test_read_script_dependencies_rejects_invalid_metadata(
+    tmp_path: Path, script_text: str
+) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(script_text)
+
+    with pytest.raises(ValueError):
+        read_script_dependencies(str(script))
