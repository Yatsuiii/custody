cies(str(script)) == [\"requests<3\", \"rich\"]\n\n\n@pytest.mark.parametrize(\n    \"metadata\",\n    [\n        \"\",\n        \"# /// other\\n# dependencies = [\\\"requests\\\"]\\n# ///\\n\",\n        \"# /// script\\n# requires-python = \\\">=3.9\\\"\\n# ///\\n\",\n        \"# /// script\\n# dependencies = \\\"requests\\\"\\n# ///\\n\",\n    ],\n)\ndef test_read_script_dependencies_rejects_malformed_metadata(\n    tmp_path: Path, metadata: str\n) -> None:\n    script = tmp_path / \"script.py\"\n    script.write_text(metadata)\n\n    with pytest.raises(ValueError):\n        read_script_dependencies(str(script))\n\n\ndef test_read_script_dependencies_ignores_unclosed_blocks(tmp_path: Path) -> None:\n    script = tmp_path / \"script.py\"\n    script.write_text(\n        \"\"\"\\\n# /// script\n# dependencies = [\"ignored\"]\nprint(\"not metadata\")\n\"\"\"\n    )\n\n    with pytest.raises(ValueError):\n        read_script_dependencies(str(script))\n\n\ndef test_read_script_dependencies_rejects_duplicate_blocks(tmp_path: Path) -> None:\n    script = tmp_path / \"script.py\"\n    script.write_text(\n        \"\"\"\\\n# /// script\n# dependencies = [\"first\"]\n# ///\n# /// script\n# dependencies = [\"second\"]\n# ///\n\"\"\"\n    )\n\n    with pytest.raises(ValueError, match=\"Multiple script\"):\n        read_script_dependencies(str(script))\n","exit_code":0,"status":"completed"}}
