+++ b/src/pip/_internal/req/script_metadata.py
@@ -0,0 +1,36 @@
+import re
+
+from pip._internal.utils.compat import tomllib
+
+_SCRIPT_METADATA_RE = re.compile(
+    r"(?m)^# /// (?P<type>[a-zA-Z0-9-]+)$\s"
+    r"(?P<content>(^#(| .*)$\s)+)^# ///$"
+)
+
+
+def read_script_dependencies(scriptfile: str) -> list[str]:
+    """Read dependencies from a PEP 723 ``script`` metadata block."""
+    with open(scriptfile, encoding="utf-8") as fp:
+        script = fp.read()
+
+    matches = [
+        match
+        for match in _SCRIPT_METADATA_RE.finditer(script)
+        if match.group("type") == "script"
+    ]
+    if len(matches) > 1:
+        raise ValueError("Multiple script metadata blocks found")
+    if not matches:
+        raise ValueError("No script metadata block found")
+
+    content = "".join(
+        line[2:] if line.startswith("# ") else line[1:]
+        for line in matches[0].group("content").splitlines(keepends=True)
+    )
+    metadata = tomllib.loads(content)
+    dependencies = metadata.get("dependencies")
+    if not isinstance(dependencies, list) or not all(
+        isinstance(dependency, str) for dependency in dependencies
+    ):
+        raise ValueError("The script metadata dependencies field is malformed")
+    return dependencies
diff --git a/tests/unit/test_script_metadata.py b/tests/unit/test_script_metadata.py
new file mode 100644
index 0000000..f468af9
--- /dev/null
+++ b/tests/unit/test_script_metadata.py
@@ -0,0 +1,73 @@
+from pathlib import Path
+
+import pytest
+
+from pip._internal.req.script_metadata import read_script_dependencies
+
+
+def test_read_script_dependencies(tmp_path: Path) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        """\
+# /// script
+# dependencies = [
+#   "requests<3",
+#   "rich",
+# ]
+# ///
+import requests
+"""
+    )
+
+    assert read_script_dependencies(str(script)) == ["requests<3", "rich"]
+
+
+@pytest.mark.parametrize(
+    "metadata",
+    [
+        "",
+        "# /// other\n# dependencies = [\"requests\"]\n# ///\n",
+        "# /// script\n# requires-python = \">=3.9\"\n# ///\n",
+        "# /// script\n# dependencies = \"requests\"\n# ///\n",
+    ],
+)
+def test_read_script_dependencies_rejects_malformed_metadata(
+    tmp_path: Path, metadata: str
+) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(metadata)
+
+    with pytest.raises(ValueError):
+        read_script_dependencies(str(script))
+
+
+def test_read_script_dependencies_ignores_unclosed_blocks(tmp_path: Path) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        """\
+# /// script
+# dependencies = ["ignored"]
+print("not metadata")
+"""
+    )
+
+    with pytest.raises(ValueError):
+        read_script_dependencies(str(script))
+
+
+def test_read_script_dependencies_rejects_duplicate_blocks(tmp_path: Path) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        """\
+# /// script
+# dependencies = ["first"]
+# ///
+print("between")
+# /// script
+# dependencies = ["second"]
+# ///
+"""
+    )
+
+    with pytest.raises(ValueError, match="Multiple script"):
+        read_script_dependencies(str(script))
