+++ b/tests/unit/test_script_metadata.py
@@ -0,0 +1,65 @@
+from pathlib import Path
+
+import pytest
+
+from pip._internal.req.script_metadata import read_script_dependencies
+
+
+def test_read_script_dependencies(tmp_path: Path) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        """\
+# /// script
+# requires-python = ">=3.9"
+# dependencies = [
+#   "requests<3",
+#   "rich",
+# ]
+# [tool.example]
+# enabled = true
+# ///
+print("hello")
+"""
+    )
+
+    assert read_script_dependencies(str(script)) == ["requests<3", "rich"]
+
+
+@pytest.mark.parametrize(
+    "metadata",
+    [
+        "# Script Dependencies:\n# requests\n",
+        "# /// other\n# dependencies = [\"requests\"]\n# ///\n",
+        "# /// script\n# dependencies = [\n#   \"requests\"\n",
+        "# /// script\n# dependencies = [\"requests\"\n# ///\n",
+        "# /// script\n# dependencies = \"requests\"\n# ///\n",
+        "# /// script\n# dependencies = [\"not a requirement !!!\"]\n# ///\n",
+    ],
+)
+def test_read_script_dependencies_rejects_malformed_or_unsupported_metadata(
+    tmp_path: Path, metadata: str
+) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(metadata)
+
+    with pytest.raises(ValueError):
+        read_script_dependencies(str(script))
+
+
+def test_read_script_dependencies_rejects_multiple_script_blocks(
+    tmp_path: Path,
+) -> None:
+    script = tmp_path / "script.py"
+    script.write_text(
+        """\
+# /// script
+# dependencies = ["requests"]
+# ///
+# /// script
+# dependencies = ["rich"]
+# ///
+"""
+    )
+
+    with pytest.raises(ValueError):
+        read_script_dependencies(str(script))
