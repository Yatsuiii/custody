+// KeysSlice returns the keys of m collected into a new slice.
+// The order of the keys in the returned slice is not specified.
+func KeysSlice[Map ~map[K]V, K comparable, V any](m Map) []K {
+	r := make([]K, 0, len(m))
+	for k := range m {
+		r = append(r, k)
+	}
+	return r
+}
