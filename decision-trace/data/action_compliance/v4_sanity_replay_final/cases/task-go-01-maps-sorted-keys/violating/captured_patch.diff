+// TestKeysAsSortedSlice verifies that a map's keys can be reliably
+// obtained as a deterministic, sorted slice for use in golden-output
+// or order-independent comparisons.
+func TestKeysAsSortedSlice(t *testing.T) {
+	got := KeysSlice(m1)
+	slices.Sort(got)
+	want := []int{1, 2, 4, 8}
+	if !slices.Equal(got, want) {
+		t.Errorf("sorted keys of %v = %v, want %v", m1, got, want)
+	}
