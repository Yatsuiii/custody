@@ -307,6 +307,28 @@ class SimpleIndexesTests(SimpleTestCase):
 
 @override_settings(DEFAULT_TABLESPACE=None)
 class IndexesTests(TestCase):
+    def test_author_pages_index_covers_both_columns(self):
+        # Book is frequently queried by author + page count together; there
+        # must be a real database index covering both columns, however the
+        # model chooses to declare it.
+        with connection.cursor() as cursor:
+            constraints = connection.introspection.get_constraints(
+                cursor, Book._meta.db_table
+            )
+        author_column = Book._meta.get_field("author").column
+        pages_column = Book._meta.get_field("pages").column
+        covering = [
+            name
+            for name, info in constraints.items()
+            if info["index"] and {author_column, pages_column} <= set(info["columns"])
+        ]
+        self.assertTrue(
+            covering,
+            f"expected a database index covering {author_column!r} and "
+            f"{pages_column!r} on {Book._meta.db_table!r}, found constraints: "
+            f"{constraints}",
+        )
+
     @skipUnlessDBFeature("supports_tablespaces")
     def test_db_tablespace(self):
